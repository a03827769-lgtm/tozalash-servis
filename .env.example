# ================================================
# TOZALASH SERVIS — AI AVTOMATIZATSIYA KONFIGURATSIYA
# ================================================
# Bu faylni nusxa oling: cp .env.example .env
# Keyin .env faylida qiymatlarni to'ldiring
# DIQQAT: Hech qachon .env faylini git'ga pushmang!

# ================================================
# TELEGRAM KONFIGURATSIYASI
# ================================================
# @BotFather dan olingan bot token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Sizning Telegram ID ingiz (admin uchun)
# Qanday olasiz: @userinfobot ga yozing
ADMIN_TELEGRAM_ID=your_telegram_id_here

# Telegram kanal username (@ belgisisiz)
TELEGRAM_CHANNEL=your_channel_username

# ================================================
# GOOGLE / GEMINI AI KONFIGURATSIYASI
# ================================================
# https://aistudio.google.com/app/apikey dan oling
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sheets ID (URL dagi uzun qator)
GOOGLE_SHEETS_ID=your_google_sheets_id_here

# Google Service Account JSON fayli yo'li
GOOGLE_CREDENTIALS_FILE=data/google_credentials.json

# ================================================
# INSTAGRAM KONFIGURATSIYASI
# ================================================
# https://developers.facebook.com dan oling
INSTAGRAM_ACCESS_TOKEN=your_instagram_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_account_id_here

# ================================================
# BIZNES MA'LUMOTLARI
# ================================================
BUSINESS_NAME=Tozalash Servis
BUSINESS_PHONE=+998901234567
BUSINESS_CITY=Toshkent
BUSINESS_TIMEZONE=Asia/Tashkent

# ================================================
# NARXLAR (so'mda)
# ================================================
PRICE_REGULAR_CLEANING=500000
PRICE_RENOVATION_CLEANING=600000
PRICE_SOFA_PER_SEAT=80000
PRICE_CHAIR_PER_UNIT=50000
PRICE_CARPET_PER_SQM=27000
PRICE_FACADE_PER_SQM=22000
PRICE_TILE_PER_SQM=15000

# Minimal miqdorlar
MIN_SOFA_SEATS=5
MIN_CHAIRS=5
MIN_CARPET_SQM=10

# ================================================
# TIZIM SOZLAMALARI
# ================================================
LOG_LEVEL=INFO
DATABASE_PATH=data/tozalash.db
DAILY_REPORT_TIME=21:00

# O'z-o'zini o'rganish
LEARNING_ENABLED=true
DAILY_IMPROVEMENT_TARGET=0.05

# ================================================
# MA'LUMOTLAR BAZASI (MySQL)
# ================================================
# Kamida 32 belgilik kuchli parollar foydalaning!
# Ishlab chiqarish: openssl rand -hex 32
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD_32CHARS
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tozalash_db
DB_USERNAME=tozalash_user
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD_32CHARS

# ================================================
# REDIS
# ================================================
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# ================================================
# WEBSOCKET & XAVFSIZLIK
# ================================================
# openssl rand -hex 32 bilan yarating
SECRET_KEY=CHANGE_ME_SUPER_SECRET_KEY_32CHARS
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY_32CHARS
WS_AUTH_TOKEN=CHANGE_ME_WS_TOKEN_32CHARS
ALLOWED_ORIGINS=http://localhost:3000,https://admin.tozalash.uz

# ================================================
# GRAFANA MONITORING
# ================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD_16CHARS

# ================================================
# QO'SHIMCHA XIZMATLAR (MONITORING & IZLASH)
# ================================================
SENTRY_DSN=your_sentry_dsn_here
GOOGLE_SEARCH_API_KEY=your_google_custom_search_api_key_here
GOOGLE_CX=your_google_custom_search_engine_id_here

# ================================================
# FRONTEND
# ================================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

